# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.

# --- Base de datos ---------------------------------------------------------
# Producción (Vercel): cadena de conexión de PostgreSQL. En Supabase: Project Settings → Database →
# Connection string → "Transaction pooler" (puerto 6543). Ej: postgresql://postgres.xxx:CLAVE@aws-0-xx.pooler.supabase.com:6543/postgres
# Si se omite, en desarrollo se usa PGlite (PostgreSQL embebido) guardado en ./.data/pglite.
DATABASE_URL=
# PGLITE_DATA_DIR=./.data/pglite

# --- URL pública (enlaces de recuperación de contraseña) -------------------
APP_URL=http://localhost:3000

# --- Asistente con IA (opcional) -------------------------------------------
# Sin clave, el chatbot funciona en "modo local" (reglas + datos), claramente indicado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Datos de mercado (opcional) -------------------------------------------
# Criptomonedas: CoinGecko público, no requiere clave.
# Acciones/ETF: Alpha Vantage (plan gratuito con límites y retraso). Sin clave se muestran datos DEMO marcados.
MARKET_DATA_PROVIDER=alpha-vantage
ALPHA_VANTAGE_API_KEY=

# --- Correo para recuperar contraseña (opcional) ---------------------------
# Sin proveedor, en desarrollo el enlace aparece en la consola del servidor y en pantalla.
RESEND_API_KEY=
MAIL_FROM=Vesor <no-reply@tu-dominio.com>

# --- Cuentas de prueba (inicialización controlada) -------------------------
# Se crean al iniciar la app si están definidas. Contraseñas: 10+ caracteres con mayúscula,
# minúscula, número y símbolo, entre comillas simples (el carácter # sin comillas inicia un comentario).
# En producción solo se crean si ALLOW_PRODUCTION_SEED=true.
SEED_ADMIN_EMAIL=admin@vesor.test
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=usuario@vesor.test
SEED_USER_PASSWORD=
# ALLOW_PRODUCTION_SEED=false
# SEED_RESET_PASSWORDS=false
